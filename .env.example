# 复制为 .env 后按需修改。所有项均有默认值，可全部留空。

# 运行环境：development | production | test
NODE_ENV=development

# 监听地址。默认仅本机可访问；改为 0.0.0.0 开放局域网前请先设置访问密码
WEBTERM_HOST=127.0.0.1

# 监听端口
WEBTERM_PORT=8080

# 数据目录（相对路径以进程工作目录为基准）
WEBTERM_DATA_DIR=./data

# 日志级别：fatal | error | warn | info | debug | trace | silent
WEBTERM_LOG_LEVEL=info

# WebSocket / CORS 来源白名单，逗号分隔
WEBTERM_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
