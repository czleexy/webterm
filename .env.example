# 复制为 .env 后按需修改。所有项均有默认值，可全部留空。

# 运行环境：development | production | test
NODE_ENV=development

# 监听地址。默认仅本机可访问。
#
# 改成 0.0.0.0 会让本服务对整个网络可见，而当前版本**没有内置的访问认证** ——
# 同网段任何人都能打开界面并以这台机器的身份发起 SSH / SFTP / 隧道操作。
# 正因如此，绑非回环地址时必须同时设置下面的 WEBTERM_ALLOW_INSECURE_LAN=1
# 才能启动（这不是认证，只是让「开放网络」成为一个明确的决定）。
# 需要远程访问，更推荐保持 127.0.0.1，然后用 SSH 端口转发：
#   ssh -L 8080:127.0.0.1:8080 你的用户名@这台机器
WEBTERM_HOST=127.0.0.1

# 确认「我知道开放局域网当前没有内置认证」。仅当 WEBTERM_HOST 非回环地址时才需要
WEBTERM_ALLOW_INSECURE_LAN=0

# 监听端口
WEBTERM_PORT=8080

# 数据目录（相对路径以进程工作目录为基准）
WEBTERM_DATA_DIR=./data

# 日志级别：fatal | error | warn | info | debug | trace | silent
WEBTERM_LOG_LEVEL=info

# WebSocket / CORS 来源白名单，逗号分隔
WEBTERM_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
