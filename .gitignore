# 依赖
node_modules/

# 构建产物
dist/
*.tsbuildinfo

# 运行时数据（含加密凭据库、日志、私钥、E2E 临时目录）
#
# 这里刻意不写 `data/`：无斜杠的模式会匹配任意层级的同名目录，连带把
# packages/server/data（服务端默认数据目录，含真实保险库与 known_hosts）也忽略掉。
# 而 git 的规则是「父目录被整体排除时，无法再放行其中的单个文件」，
# 所以既要保留对子包的忽略，又要放行根目录下的验证脚本，只能按层级显式书写。
/data/*
!/data/tmp/
/data/tmp/*
# 例外：各阶段的端到端验证入口与定位探针随仓库分发 ——
# docs/03-测试指南.md 里按路径引用了它们，且这些脚本只用内置 mock 与临时目录，不含任何凭据
!/data/tmp/e2e-phase3.mjs
!/data/tmp/e2e-browser-p3.mjs
!/data/tmp/probe-p3-list.mjs
!/data/tmp/probe-p3-server.mjs
!/data/tmp/e2e-telnet.mjs
!/data/tmp/e2e-browser-telnet.mjs
!/data/tmp/e2e-tunnel.mjs
!/data/tmp/e2e-browser-tunnel.mjs
!/data/tmp/e2e-automation.mjs
!/data/tmp/e2e-browser-automation.mjs
!/data/tmp/e2e-logging.mjs
!/data/tmp/e2e-browser-logging.mjs
!/data/tmp/e2e-browser-phase8.mjs
!/data/tmp/e2e-plugin.mjs
!/data/tmp/e2e-browser-plugin.mjs
!/data/tmp/probe-release.mjs
!/data/tmp/probe-plugins.mjs

# 示例插件随仓库分发：它是插件机制的参考实现，也是「把目录放进去就能用」的示范。
# 目录必须先放行，否则 git 不会下探，里面的 ! 规则全部无效。
!/data/plugins/
!/data/plugins/**

# 子包内的运行时数据目录（服务端默认数据目录等）
packages/*/data/

# 打包产物（scripts/package-portable.mjs 的输出）
release/

# docker compose 示例挂载出来的宿主目录（含加密凭据库）
docker-data/
docker-files/

# 环境变量
.env
.env.local
.env.*.local

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*
